{
  "name": "slmonitor",
  "version": "0.1.0",
  "description": "Starlink监控软件 - 专业的星链终端监控解决方案",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:5173 && cross-env NODE_ENV=development tsx src/main/dev.ts",
    "electron:build": "tsx scripts/build-electron.mjs",
    "build": "vite build && npm run electron:build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "download-prometheus": "node scripts/download-prometheus.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@react-three/drei": "^9.119.1",
    "@react-three/fiber": "^8.17.10",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.20.0",
    "better-sqlite3": "12.11.1",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "electron-updater": "^6.3.9",
    "i18next": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^6.28.0",
    "satellite.js": "^7.1.0",
    "sql.js": "^1.12.0",
    "ssh2": "^1.16.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.1",
    "@types/three": "^0.171.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.13.0",
    "lucide-react": "^1.61.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.slmonitor.app",
    "productName": "SLMonitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ssh2@1.17.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
