{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "dist-electron",
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/core/*": ["src/core/*"],
      "@/renderer/*": ["src/renderer/*"],
      "@/collector/*": ["src/collector/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/core/**/*",
    "src/collector/**/*",
    "src/alerting/**/*",
    "src/prometheus/**/*",
    "src/config/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "src/renderer"
  ]
}